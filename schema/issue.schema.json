{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/signalreason/agent-issue-protocol/main/schema/issue.schema.json",
  "title": "Agent Issue Protocol Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "owner",
    "goal",
    "acceptance_criteria",
    "acceptance_tests",
    "inputs",
    "outputs",
    "dependencies",
    "risks",
    "constraints",
    "non_goals",
    "lease"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "claimed",
        "in-progress",
        "review",
        "blocked",
        "done",
        "canceled"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 3
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue"
        ],
        "properties": {
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed_by",
        "claimed_at",
        "expires_at"
      ],
      "properties": {
        "claimed_by": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "claimed_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
